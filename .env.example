# Copy to .env. Permanent credentials stay on the backend or secure mirror settings.
XMAX_API_KEY=
OPENBUY_API_PORT=3002
OPENBUY_DATA_DIR=.data
OPENBUY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://xuminghong.local:10200,https://xuminghong.local:10202
# Per-session temporary credential limit and lifetime; no local cumulative budget.
XMAX_SESSION_CREDITS=30
XMAX_TOKEN_EXPIRE_SECONDS=120
