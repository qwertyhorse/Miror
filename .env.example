# Copy to .env. Permanent credentials stay on the backend or secure mirror settings.
XMAX_API_KEY=
OPENBUY_API_PORT=3002
OPENBUY_DATA_DIR=.data
# Temporarily hide provider switching. Set true and rebuild to restore the panel.
VITE_EXHIBITION_SHOW_PROVIDER_SETTINGS=false
OPENBUY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://xuminghong.local:10200,http://xuminghong.local:10201,http://xuminghong.local:10601,https://xuminghong.local:10202
# Defaults for mirrors without saved session limits. The control panel can override
# them per mirror; no local cumulative budget. Permanent credentials stay server-side.
XMAX_SESSION_CREDITS=30
XMAX_TOKEN_EXPIRE_SECONDS=120
